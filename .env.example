# Kalshi API credentials
KALSHI_API_KEY=your_kalshi_api_key_here
KALSHI_BASE_URL=https://trading-api.kalshi.com/trade-api/v2

# iMessage recipient (Apple ID email or phone number)
IMESSAGE_TO=you@me.com

# Database path
DB_PATH=kalshi_nba.db

# Analysis tuning
MIN_EDGE_THRESHOLD=0.05
RECENT_GAMES_WINDOW=10
DECAY_FACTOR=0.92

# Scheduling (24h format, ET)
MORNING_SCAN_HOUR=10
PREGAME_ALERT_MINUTES_BEFORE=60
