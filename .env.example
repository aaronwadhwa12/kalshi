# Kalshi API credentials
KALSHI_API_KEY=your_kalshi_api_key_here
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# BallDontLie API (free at app.balldontlie.io — used for player game logs)
BALLDONTLIE_API_KEY=your_balldontlie_key_here

# ── Notification channels (configure at least one) ──────────────────────────

# Telegram (recommended — free, works everywhere)
# Setup: message @BotFather → /newbot → copy token
#        send /start to your bot → get chat_id from getUpdates
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=987654321

# ntfy.sh (free push notifications — install ntfy app, subscribe to topic)
NTFY_TOPIC=kalshi-nba-yourname

# Email via Gmail SMTP
# Enable 2FA on Google → App Passwords → generate one for "Mail"
EMAIL_TO=you@gmail.com
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Discord webhook (Server Settings → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# iMessage (macOS only — script must run on your Mac)
IMESSAGE_TO=you@me.com

# ── Database & tuning ────────────────────────────────────────────────────────
DB_PATH=kalshi_nba.db
MIN_EDGE_THRESHOLD=0.05
RECENT_GAMES_WINDOW=10
DECAY_FACTOR=0.92

# ── Scheduler (local only — GitHub Actions uses its own schedule) ────────────
MORNING_SCAN_HOUR=10
PREGAME_ALERT_MINUTES_BEFORE=60
